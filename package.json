{
  "name": "my-pokedex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images": "node scripts/downloadPokemonImages.mjs",
    "sitemap": "tsx scripts/generateSitemap.mjs",
    "build-candidate": "POKEDEX_SNAPSHOT=record tsx scripts/buildCandidate.mjs",
    "fetch:candidate": "npm run build-candidate && node scripts/downloadPokemonImages.mjs \"$(jq -r .recordCount data/candidate/manifest.json)\"",
    "validate": "POKEDEX_SNAPSHOT=replay tsx scripts/validateCandidate.mjs",
    "build:snapshot": "POKEDEX_SNAPSHOT=replay tsx scripts/generateSitemap.mjs && POKEDEX_SNAPSHOT=replay npm run check-fr-coverage && POKEDEX_SNAPSHOT=replay next build && node scripts/inject-sw-version.mjs",
    "predev": "node scripts/downloadPokemonImages.mjs && tsx scripts/generateSitemap.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/downloadPokemonImages.mjs && tsx scripts/generateSitemap.mjs && npm run check-fr-coverage",
    "check-fr-coverage": "tsx scripts/checkFrCoverage.mjs",
    "translate-fr": "tsx scripts/translateFrStubs.mjs",
    "fill-fr": "tsx scripts/fillFrFromPokepedia.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "postbuild": "node scripts/inject-sw-version.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.15",
    "@types/node": "^20.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "brace-expansion": "5.0.8"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 iOS versions",
    "not dead"
  ]
}
